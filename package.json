{
  "name": "love-duo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "type": "module",
  "scripts": {
    "dev": "expo start",
    "build": "tsc",
    "start": "expo start",
    "android": "expo run:android",
    "android:dev": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "validate": "eslint . --ext .ts,.tsx && prettier --check . && tsc --noEmit",
    "prebuild": "expo prebuild",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:e2e": "jest --testPathPattern=tests/e2e",
    "test:a11y": "jest --testPathPattern=tests/a11y",
    "test:watch": "jest --watch",
    "test:onboarding": "jest --testPathPattern=tests/unit/onboarding",
    "debug": "node --inspect-brk dist/main.js",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "web:build": "expo export --platform web",
    "doctor": "npx expo-doctor",
    "prepare": "husky"
  },
  "dependencies": {
    "expo": "54.0.23",
    "expo-constants": "18.0.10",
    "expo-dev-client": "6.0.17",
    "expo-linear-gradient": "15.0.7",
    "expo-linking": "8.0.8",
    "expo-router": "6.0.14",
    "expo-sqlite": "16.0.9",
    "expo-status-bar": "3.0.8",
    "expo-system-ui": "6.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "5.6.0",
    "react-native-screens": "4.16.0",
    "react-native-web": "0.21.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.1.10",
    "@typescript-eslint/eslint-plugin": "8.46.4",
    "@typescript-eslint/parser": "8.46.4",
    "eslint": "9.39.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.1.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-expo": "54.0.13",
    "lint-staged": "16.2.6",
    "prettier": "3.6.2",
    "react-test-renderer": "19.1.0",
    "typescript": "5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverage": true,
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  },
  "private": true
}
